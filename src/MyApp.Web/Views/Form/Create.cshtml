@model FormSubmissionInputModel
@{
    ViewData["Title"] = Model.QuestionnaireTitle;
    var sections = Model.Sections;
}

<section class="form-intro">
    <p class="eyebrow">Secure submission</p>
    <h1>@Model.QuestionnaireTitle</h1>
    <p>Complete each tab in order, or select a tab to move between sections. Save your progress at any time; your draft is stored securely in your account.</p>
</section>

<form asp-action="Save" method="post" class="submission-form" id="questionnaire-form" novalidate>
    <input asp-for="DraftId" type="hidden" />
    <input asp-for="QuestionnaireType" type="hidden" />
    <input asp-for="ActiveSection" type="hidden" id="active-section" />
    <div asp-validation-summary="All" class="validation-summary"></div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <p class="notice" role="status">@successMessage</p>
    }

    <div class="questionnaire-tabs" role="tablist" aria-label="Questionnaire sections">
        @for (var index = 0; index < sections.Count; index++)
        {
            var tabId = $"questionnaire-tab-{index + 1}";
            var panelId = $"questionnaire-panel-{index + 1}";
            var isActive = Model.ActiveSection == index + 1;
            <button type="button"
                    class="questionnaire-tab@(isActive ? " is-active" : string.Empty)"
                    id="@tabId"
                    role="tab"
                    aria-controls="@panelId"
                    aria-selected="@isActive.ToString().ToLowerInvariant()"
                    tabindex="@(isActive ? "0" : "-1")"
                    data-section="@sections[index].Number">
                <span class="questionnaire-tab-number">@sections[index].Number</span>
                @Model.TabTitles[index]
            </button>
        }
    </div>

    @foreach (var formSection in sections)
    {
        var isActive = Model.ActiveSection == formSection.Number;
        var panelId = $"questionnaire-panel-{formSection.Number}";
        var tabId = $"questionnaire-tab-{formSection.Number}";
        var recordNumbers = new List<int> { 1 };
        if (formSection.Repeatable)
        {
            for (var recordNumber = 2; recordNumber <= 20; recordNumber++)
            {
                var suffix = $"__{recordNumber}";
                if (formSection.Questions.Any(question => Model.Answers.ContainsKey(question.Key + suffix)))
                {
                    recordNumbers.Add(recordNumber);
                }
            }
        }

        <section class="questionnaire-tab-panel"
                 id="@panelId"
                 role="tabpanel"
                 aria-labelledby="@tabId"
                 tabindex="0"
                 data-section-panel="@formSection.Number"
                 hidden="@(!isActive)">
            <div class="form-section">
                <p class="eyebrow">Section @formSection.Number of @sections.Count</p>
                <h2>@formSection.Title</h2>
            </div>
            @foreach (var recordNumber in recordNumbers)
            {
                var sectionId = $"section-{formSection.Number}-record-{recordNumber}";
                var headingId = $"section-heading-{formSection.Number}-record-{recordNumber}";
                var recordSuffix = recordNumber == 1 ? string.Empty : $"__{recordNumber}";
                <section class="form-section questionnaire-section"
                         id="@sectionId"
                         aria-labelledby="@headingId"
                         data-section-key="@formSection.Number"
                         data-section-title="@formSection.Title"
                         data-repeatable="@formSection.Repeatable.ToString().ToLowerInvariant()">
                    <div class="questionnaire-section-heading">
                        <h3 id="@headingId">@formSection.Number. @formSection.Title@(recordNumber == 1 ? string.Empty : $" (additional record {recordNumber})")</h3>
                        @if (formSection.Repeatable)
                        {
                            <button class="button button-secondary repeat-record" type="button">Add another record</button>
                        }
                    </div>
                    <div class="table-scroll">
                        <table class="form-table">
                            <tbody>
                                @{
                                    var previousGroupTitle = string.Empty;
                                }
                                @foreach (var question in formSection.Questions)
                                {
                                    var answerKey = question.Key + recordSuffix;
                                    var fieldId = $"answer-{answerKey}";
                                    var value = Model.Answers.TryGetValue(answerKey, out var answer) ? answer : string.Empty;
                                    if (!string.IsNullOrEmpty(question.GroupTitle) &&
                                        question.GroupTitle != formSection.Title &&
                                        question.GroupTitle != previousGroupTitle)
                                    {
                                        <tr class="question-group-heading">
                                            <th colspan="2">@question.GroupTitle</th>
                                        </tr>
                                    }
                                    <tr>
                                        <th scope="row"><label for="@fieldId">@question.Label</label></th>
                                        <td>
                                            @if (question.Type == FormQuestionType.Checkbox)
                                            {
                                                <input id="@fieldId"
                                                       name="Answers[@answerKey]"
                                                       type="checkbox"
                                                       value="Yes"
                                                       checked="@(value == "Yes" ? "checked" : null)" />
                                            }
                                            else if (question.Type == FormQuestionType.YesNo)
                                            {
                                                <select id="@fieldId" name="Answers[@answerKey]">
                                                    <option value="">Choose Yes or No</option>
                                                    <option value="Yes" selected="@(value == "Yes" ? "selected" : null)">Yes</option>
                                                    <option value="No" selected="@(value == "No" ? "selected" : null)">No</option>
                                                </select>
                                            }
                                            else if (question.Type == FormQuestionType.LongText)
                                            {
                                                <textarea id="@fieldId" name="Answers[@answerKey]" rows="3" maxlength="4000">@value</textarea>
                                            }
                                            else
                                            {
                                                var inputType = question.Type switch
                                                {
                                                    FormQuestionType.Date => "date",
                                                    FormQuestionType.Number => "number",
                                                    FormQuestionType.Email => "email",
                                                    _ => "text"
                                                };
                                                <input id="@fieldId" name="Answers[@answerKey]" type="@inputType" value="@value" maxlength="4000" />
                                            }
                                            @Html.ValidationMessage($"Answers[{answerKey}]", null, new { @class = "field-error" })
                                        </td>
                                    </tr>
                                    previousGroupTitle = question.GroupTitle ?? string.Empty;
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        </section>
    }

    <div class="form-actions questionnaire-actions">
        <button class="button button-secondary" type="submit" name="intent" value="save">Save</button>
        <button class="button"
                type="submit"
                name="intent"
                value="continue"
                hidden="@(Model.ActiveSection == sections.Count)">Save and continue</button>
        <button class="button"
                type="submit"
                name="intent"
                value="submit"
                hidden="@(Model.ActiveSection != sections.Count)">Submit questionnaire</button>
    </div>
</form>

@section Scripts {
    <script src="~/js/questionnaire.js" asp-append-version="true"></script>
}
