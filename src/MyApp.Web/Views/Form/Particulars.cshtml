            <caption>Business particulars</caption>
            <thead>
                <tr>
                    <th scope="col">Particulars</th>
                    <th scope="col">Details</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th scope="row">Business/Practice Name</th>
                    <td>Anchor Migration and Education Consultants</td>
                </tr>
                <tr>
                    <th scope="row">ABN</th>
                    <td>46 240 703 967</td>
                </tr>
                <tr>
                    <th scope="row">Contact Address</th>
                    <td>Level 27/32 Turbot St, Brisbane City, QLD 4000, Australia</td>
                </tr>
                <tr>
                    <th scope="row">Email</th>
                    <td><a href="mailto:visa@anchormigration.com.au">visa@anchormigration.com.au</a></td>
                </tr>
                <tr>
                    <th scope="row">Phone</th>
                    <td><a href="tel:+61478709991">+61 478 709 991</a></td>
                </tr>
                <tr>
                    <th scope="row">Primary Responsible Person</th>
                    <td>Mr Muhammad Salman Khan</td>
                </tr>
                <tr>
                    <th scope="row">Professional Registration</th>
                    <td>Registered Migration Agent (AUS)</td>
                </tr>
                <tr>
                    <th scope="row">MARN</th>
                    <td>1806993</td>
                </tr>
                <tr>
                    <th scope="row">Other Responsible Persons</th>
                    <td>Details are provided in Schedule A, if applicable.</td>
                </tr>
            </tbody>
        </table>
    </div>
</section>

<div class="form-actions">
    <a class="button" asp-action="Create">Continue to questionnaire</a>
</div>
