@model RegisterViewModel
@{
    ViewData["Title"] = "Create account";
}

<section class="panel narrow">
    <h1>Create an account</h1>
    <p>Register to access the secure questionnaire. Use at least 12 characters, including uppercase, lowercase, a number, and a symbol.</p>
    <form asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="field">
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="email" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="new-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>
        <button class="button" type="submit">Create account</button>
    </form>
    <p class="form-footnote">Already registered? <a asp-action="Login">Sign in</a></p>
</section>
