@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<section class="panel narrow">
    <h1>Sign in</h1>
    <p>Sign in to open the protected form and your submissions.</p>
    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="field">
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="username" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <div class="checkbox-field">
            <input asp-for="RememberMe" />
            <label asp-for="RememberMe"></label>
        </div>
        <button class="button" type="submit">Sign in</button>
    </form>
    <p class="form-footnote">New here? <a asp-action="Register">Create an account</a></p>
</section>
