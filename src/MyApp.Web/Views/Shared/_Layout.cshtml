<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - MyApp</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a class="brand" asp-controller="Home" asp-action="Index">MyApp</a>
        <nav aria-label="Main navigation">
            <details class="visa-dropdown">
                <summary>Visa types</summary>
                <div class="visa-dropdown-panel">
                    <p class="visa-dropdown-note">Our current visa questionnaire services.</p>
                    <div class="visa-type-group">
                        <h2>Family</h2>
                        <ul>
                            <li><a asp-controller="Form" asp-action="Create" asp-route-questionnaireType="agedRemainingRelative" asp-route-newDraft="true">Aged/Remaining Relative Visas Questionnaire</a></li>
                            <li><a asp-controller="Form" asp-action="Create" asp-route-questionnaireType="childOver18" asp-route-newDraft="true">Child Visa Questionnaire (Over 18)</a></li>
                            <li><a asp-controller="Form" asp-action="Create" asp-route-questionnaireType="childUnder18" asp-route-newDraft="true">Child Visa Questionnaire (Under 18)</a></li>
                            <li><a asp-controller="Form" asp-action="Create" asp-route-questionnaireType="parentPermanent" asp-route-newDraft="true">Parent (Permanent) Visa Questionnaire</a></li>
                            <li><a asp-controller="Form" asp-action="Create" asp-route-questionnaireType="partnerVisa" asp-route-newDraft="true">Partner Visas Questionnaire</a></li>
                            <li><a asp-controller="Form" asp-action="Create" asp-route-questionnaireType="partnerVisaNoForm80" asp-route-newDraft="true">Partner Visas Questionnaire - No Form 80</a></li>
                        </ul>
                    </div>
                    <div class="visa-type-group">
                        <h2>Working and Skilled</h2>
                        <ul>
                            <li><a asp-controller="Form" asp-action="Create" asp-route-questionnaireType="businessVisa" asp-route-newDraft="true">Business Visa Client Questionnaire</a></li>
                            <li><a asp-controller="Form" asp-action="Create" asp-route-questionnaireType="ensRsms" asp-route-newDraft="true">ENS/RSMS Visa Questionnaire</a></li>
                            <li><a asp-controller="Form" asp-action="Create" asp-route-questionnaireType="graduate485" asp-route-newDraft="true">Graduate (485) Visa Questionnaire</a></li>
                            <li><a asp-controller="Form" asp-action="Create" asp-route-questionnaireType="graduate485NoForm80" asp-route-newDraft="true">Graduate (485) Visa Questionnaire - No Form 80</a></li>
                            <li><a asp-controller="Form" asp-action="Create" asp-route-questionnaireType="skilled189190" asp-route-newDraft="true">Skilled (189/190) Visas Questionnaire</a></li>
                            <li><a asp-controller="Form" asp-action="Create" asp-route-questionnaireType="temporaryActivity408" asp-route-newDraft="true">Temporary Activity (408) Visa Questionnaire</a></li>
                            <li><a asp-controller="Form" asp-action="Create" asp-route-questionnaireType="temporaryWork400" asp-route-newDraft="true">Temporary Work (400) Visa Questionnaire</a></li>
                            <li><a asp-controller="Form" asp-action="Create" asp-route-questionnaireType="skillsInDemand482" asp-route-newDraft="true">Skills in Demand (482) Questionnaire</a></li>
                            <li><a asp-controller="Form" asp-action="Create" asp-route-questionnaireType="skillsInDemand482SubsequentEntrant" asp-route-newDraft="true">Skills in Demand (482) Subsequent Entrant Questionnaire</a></li>
                            <li><a asp-controller="Form" asp-action="Create" asp-route-questionnaireType="talent124858" asp-route-newDraft="true">Talent (124/858) Visa Questionnaire</a></li>
                            <li><a asp-controller="Form" asp-action="Create" asp-route-questionnaireType="talent124858NoForm80" asp-route-newDraft="true">Talent (124/858) Visa Questionnaire - No Form 80</a></li>
                        </ul>
                    </div>
                    <div class="visa-type-group">
                        <h2>Student</h2>
                        <ul>
                            <li><a asp-controller="Form" asp-action="Create" asp-route-questionnaireType="student500" asp-route-newDraft="true">Student Visa Questionnaire</a></li>
                        </ul>
                    </div>
                    <div class="visa-type-group">
                        <h2>Visitors</h2>
                        <ul>
                            <li><a asp-controller="Form" asp-action="Create" asp-route-questionnaireType="visitorVisa" asp-route-newDraft="true">Visitor Visa Questionnaire</a></li>
                        </ul>
                    </div>
                    <div class="visa-type-group">
                        <h2>Form 80</h2>
                        <ul>
                            <li><a asp-controller="Form" asp-action="Create" asp-route-questionnaireType="form80Over16" asp-route-newDraft="true">Form 80 Questionnaire for Over 16 Applicants</a></li>
                        </ul>
                    </div>
                </div>
            </details>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Form" asp-action="Index">My questionnaires</a>
                <span class="account-name">@User.Identity.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="nav-form">
                    <button class="link-button" type="submit">Sign out</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">Sign in</a>
                <a asp-controller="Account" asp-action="Register">Create account</a>
            }
        </nav>
    </header>
    <main class="container">
        @RenderBody()
    </main>
    <footer class="site-footer">Secure questionnaire submissions</footer>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        document.querySelector(".visa-dropdown")?.addEventListener("click", event => {
            if (event.target instanceof Element && event.target.closest("a")) {
                event.currentTarget.open = false;
            }
        });
    </script>
</body>
</html>
